# 서버의 ~/market/.env 로 복사해서 값을 채운다 (깃에 올리지 않는다)
# JWT_SECRET: openssl rand -base64 48
JWT_SECRET=
# DB_PASSWORD: openssl rand -base64 24
DB_PASSWORD=
PORTONE_API_SECRET=
# PortOne 콘솔의 웹훅 시크릿(whsec_...). 웹훅 URL을 등록할 때 채운다
PORTONE_WEBHOOK_SECRET=
# GRAFANA_PASSWORD는 배포 때 서버에서 자동으로 만든다. 직접 정하려면 GRAFANA_PASSWORD=값 을 추가한다
